        missing_columns = [name for name, value in campaign_columns.items() if value is None]
        if missing_columns:
            raise KeyError(
                "Campaign report missing columns: "
                + ", ".join(missing_columns)
            )

        application_col = campaign_columns["Application"]
        user_id_col = campaign_columns["UserID"]
        permission_col = campaign_columns["Orig_Permissions"]
        response_col = campaign_columns["Response"]
        response_date_col = campaign_columns["ResponseStatusDate"]
        ticket_col = campaign_columns["Ticket Number"]

        campaign_clean = campaign_clean[
            campaign_clean[application_col]
            .fillna("")
            .astype(str)
            .str.strip()
            .str.lower()
            == "asc/claimsops"
        ].copy()

        for col in [user_id_col, permission_col, response_col]:
            campaign_clean[col] = (
                campaign_clean[col]
                .fillna("")
                .astype(str)
                .str.strip()
                .str.lower()
            )

        campaign_clean["comparison_key"] = (
            campaign_clean[user_id_col]
            + "||"
            + campaign_clean[permission_col]
        )
        claimsops_key = (
            str(row["SAMAccountName"]).strip().lower()
            + "||"
            + str(row["GroupName"]).strip().lower()
        )

        matching_campaign = campaign_clean[
            campaign_clean["comparison_key"] == claimsops_key
        ]

        if matching_campaign.empty:
            row["provisioning_employee_deletion_date"] = ""
            failure_reason_data.append("NOT_PRESENT_IN_CAMPAIGN")
            out_comment = (
                f"SAMAccountName {row['SAMAccountName']} and "
                f"GroupName {row['GroupName']} not present in "
                "Campaign report under Application ASC/ClaimsOps"
            )
        else:
            campaign_row = matching_campaign.iloc[0]
            response_data = campaign_row[response_col]
            manager_response = str(response_data).upper()
            response_text = str(response_data).strip().lower()
            manager_response_date = campaign_row[response_date_col]

            effective_date = get_row_value(row, ["Effective Date", "effective date"])
            provisioning_date = get_row_value(
                row, ["provisioning_employee_deletion_date"]
            )
            manager_effective_diff_date = get_absolute_date_difference(
                effective_date, manager_response_date
            )
            provisioning_manager_diff_date = get_absolute_date_difference(
                provisioning_date, manager_response_date
            )
            sla_values = [
                manager_effective_diff_date,
                provisioning_manager_diff_date,
            ]
            sla_failure_status = None
            sla_comment = ""

            if any(value is None for value in sla_values):
                failure_reason_data.append("INVALID_SLA_DATE")
                sla_failure_status = "Manual QC"
                sla_comment = (
                    "Unable to validate the 30-day SLA because Effective Date, "
                    "Provisioning Date, or Campaign ResponseStatusDate is blank/invalid"
                )
            elif any(value > 30 for value in sla_values):
                failure_reason_data.append("SLA_EXCEEDED_30_DAYS")
                sla_failure_status = "Failed"
                sla_comment = (
                    f"Campaign Response is {manager_response}, but the Effective Date/"
                    "Provisioning Date and Campaign ResponseStatusDate difference "
                    "is more than 30 days"
                )

            if response_text == "keep":
                current_exists = check_campaign_week(row, context.get("claimsops"))
                next_claimsops_df = context.get(
                    "next_claimsops", context.get("claimops_next")
                )
                next_exists = check_campaign_week(row, next_claimsops_df)
                if current_exists and next_exists:
                    curr_qc_status = "Passed"
                    send_mail = claimops_send_mail[1]
                    row["evidence"] = context.get("campaign_report_filepath", "")
                    out_comment = (
                        "Campaign Response is KEEP; SAMAccountName and GroupName "
                        "are present in current and next week ClaimsOps reports; "
                        "30-day SLA validated"
                    )
                else:
                    failure_reason_data.append("KEEP_PERMISSION_NOT_FOUND")
                    out_comment = (
                        "Campaign Response is KEEP, but SAMAccountName and GroupName "
                        "are not present in both current and next week ClaimsOps reports"
                    )

            elif response_text == "remove":
                ticket_number = str(campaign_row[ticket_col]).strip()
                row["ticket_no"] = ticket_number
                if not ticket_number or ticket_number.lower() == "nan":
                    failure_reason_data.append("TICKET_PROCESSING_ISSUE")
                    out_comment = (
                        "Campaign Response is REMOVE, but ServiceNow Ticket Number is blank"
                    )
                else:
                    (
                        ticket_valid, ticket_state, ticket_open_date,
                        ticket_evidence, ticket_comment,
                    ) = validate_claimsops_servicenow_ticket(
                        ticket_number=ticket_number,
                        lanid=str(row["SAMAccountName"]).strip(),
                        permission=str(row["GroupName"]).strip(),
                    )
                    row["ticket_creation_date"] = ticket_open_date
                    row["ticket_status"] = ticket_state
                    row["evidence"] = ticket_evidence
                    exists_next_week = check_campaign_next_week(row, context)
                    if not ticket_valid:
                        failure_reason_data.append("TICKET_PROCESSING_ISSUE")
                        out_comment = ticket_comment
                    elif exists_next_week:
                        failure_reason_data.append("NEXT_WEEK_DATA_OVERLAP")
                        out_comment = (
                            ticket_comment
                            + "; Campaign Response is REMOVE, but SAMAccountName and "
                            "GroupName are present in next week ClaimsOps report"
                        )
                    else:
                        curr_qc_status = "Passed"
                        send_mail = claimops_send_mail[1]
                        out_comment = (
                            ticket_comment
                            + "; Campaign Response is REMOVE; permission is absent "
                            "from next week ClaimsOps report; 30-day SLA validated"
                        )
            else:
                failure_reason_data.append("INVALID_CAMPAIGN_RESPONSE")
                out_comment = (
                    "Campaign Response should be KEEP or REMOVE "
                    f"but got {response_data}"
                )

            if sla_failure_status is not None:
                curr_qc_status = sla_failure_status
                send_mail = claimops_send_mail[0]
                out_comment = "; ".join(
                    value for value in [out_comment, sla_comment] if value
                )

    except Exception as e:
        logger.error(
            "Found exception in ClaimsOps Campaign validation: "
            f"{e}"
        )
        curr_qc_status = "Manual QC"
        send_mail = claimops_send_mail[0]
        failure_reason_data.append(
            "CAMPAIGN_VALIDATION_ERROR"
        )
        out_comment = str(e)

    row["qc_status"] = curr_qc_status
    row["comment"] = out_comment
    row["send_mail"] = send_mail
    row["manager_response"] = manager_response
    row["manager_response_date"] = manager_response_date
    valid_sla_values = [
        value
        for value in [manager_effective_diff_date, provisioning_manager_diff_date]
        if value is not None
    ]
    row["within_30_days"] = max(valid_sla_values) if valid_sla_values else ""
    row["control_as_per_ticket"] = "Transfer"
    row["failure_reason"] = ", ".join(
        sorted(set(failure_reason_data))
    )

    return row


def check_campaign_next_week(row, context):
    next_claimsops_df = context.get(
        "next_claimsops",
        context.get("claimops_next"),
    )

    return check_campaign_week(row, next_claimsops_df)


def check_campaign_week(row, claimsops_df):
    if claimsops_df is None or claimsops_df.empty:
        return False

    claimsops_df = claimsops_df.copy()
    if not {"SAMAccountName", "GroupName"}.issubset(claimsops_df.columns):
        return False

    for col in ["SAMAccountName", "GroupName"]:
        claimsops_df[col] = (
            claimsops_df[col]
            .fillna("")
            .astype(str)
            .str.strip()
            .str.lower()
        )

    next_keys = set(
        claimsops_df["SAMAccountName"]
        + "||"
        + claimsops_df["GroupName"]
    )

    current_key = (
        str(row["SAMAccountName"]).strip().lower()
        + "||"
        + str(row["GroupName"]).strip().lower()
    )

    return current_key in next_keys


def get_column_name(data_frame, expected_name):
    expected_key = "".join(
        char for char in expected_name.lower() if char.isalnum()
    )
    for column in data_frame.columns:
        column_key = "".join(
            char for char in str(column).lower() if char.isalnum()
        )
        if column_key == expected_key:
            return column
    return None


def get_row_value(row, candidate_names):
    normalized_candidates = {
        "".join(char for char in name.lower() if char.isalnum())
        for name in candidate_names
    }
    for column in row.index:
        column_key = "".join(
            char for char in str(column).lower() if char.isalnum()
        )
        if column_key in normalized_candidates:
            return row[column]
    return None


def get_absolute_date_difference(first_date, second_date):
    if pd.isna(first_date) or pd.isna(second_date):
        return None
    if not str(first_date).strip() or not str(second_date).strip():
        return None
    first_timestamp = pd.to_datetime(first_date, errors="coerce")
    second_timestamp = pd.to_datetime(second_date, errors="coerce")
    if pd.isna(first_timestamp) or pd.isna(second_timestamp):
        return None
    return abs((second_timestamp - first_timestamp).days)


def validate_claimsops_servicenow_ticket(ticket_number, lanid, permission):
    """Validate REMOVE tickets using the same CHG/RITM pattern as Infra."""
    ticket_number_key = str(ticket_number).strip().lower()
    default_result = (False, "", "", "", "ServiceNow ticket is not found")

    try:
        if ticket_number_key.startswith("chg"):
            response = service_connector_obj.get_change_request_from_lanid(
                lanid, system_limit=""
            )
        elif ticket_number_key.startswith("ritm"):
            response = service_connector_obj.get_ticket_from_lanid(
                lanid,
                category="ePAR (Electronic Privileged Access Request)",
            )
        else:
            return False, "", "", "", "Ticket Number must start with CHG or RITM"

        if response.status_code != 200:
            return default_result
        ticket_objects = response.json().get("result", [])
        if not isinstance(ticket_objects, list):
            return default_result

        for ticket_object in ticket_objects:
            if ticket_number_key.startswith("chg"):
                ticket_id = str(ticket_object.get("number", "")).strip()
                if ticket_id.lower() != ticket_number_key:
                    continue
                state = str(ticket_object.get("state", "")).strip()
                opened_at = ticket_object.get("opened_at", "")
                short_description = ticket_object.get("short_description", "")
                description = ticket_object.get("description", "")
                approval = ticket_object.get("approval", "")
                evidence = str(ticket_object)
            else:
                request_detail = ticket_object.get("Request detail", {}) or {}
                ticket_id = str(request_detail.get("number", "")).strip()
                if ticket_id.lower() != ticket_number_key:
                    continue
                variables = ticket_object.get("variables", {}) or {}
                state = str(request_detail.get("state", "")).strip()
                opened_at = request_detail.get("created", "")
                short_description = request_detail.get("shortDescription", "")
                description = f"{short_description} {variables}"
                approval = variables.get("approvalState", "")
                evidence = str(ticket_object)

            validation_errors = []
            combined_text = f"{short_description} {description}".lower()
            if str(approval).strip().lower() != "approved":
                validation_errors.append(
                    f"ticket approval should be Approved but got {approval}"
                )
            if ticket_number_key.startswith("chg") and state != "3":
                validation_errors.append(
                    "CHG state should be Closed but got "
                    + state_id_to_str.get(state, state)
                )
            if (
                ticket_number_key.startswith("ritm")
                and state.lower() != "closed complete"
            ):
                validation_errors.append(
                    f"RITM state should be Closed Complete but got {state}"
                )
            if "remove" not in combined_text:
                validation_errors.append("Remove keyword is not present in the ticket")
            if str(lanid).strip().lower() not in combined_text:
                validation_errors.append(f"LAN ID {lanid} is not present in the ticket")
            if str(permission).strip().lower() not in combined_text:
                validation_errors.append(
                    f"permission {permission} is not present in the ticket"
                )

            if validation_errors:
                return False, state, opened_at, evidence, "; ".join(validation_errors)
            return (
                True,
                state,
                opened_at,
                evidence,
                f"ServiceNow ticket {ticket_number} validated correctly",
            )
    except Exception as exc:
        logger.error(f"ClaimsOps ServiceNow ticket validation failed: {exc}")
        return False, "", "", "", f"ServiceNow validation error: {exc}"

    return default_result


def convert_within_30_to_yes_no(df):
    if "within_30_days" not in df.columns:
        df["within_30_days"] = None

    s = pd.to_numeric(df["within_30_days"], errors="coerce")
    df["within_30_days"] = (
        s.where(
            s.isna(),
            s.map(lambda x: "YES" if x <= 30 else "NO"),
        )
    )
    return df


def _is_date_like_annotation(annotation: Any) -> bool:
    if annotation is date:
        return True
    origin = get_origin(annotation)
    if origin is Union:
        args = [arg for arg in get_args(annotation) if arg is not type(None)]
        return len(args) == 1 and args[0] is date
    return False


def get_model_date_columns() -> list:
    models = (
        data_model.EmployeeInfo,
        data_model.QCColumn,
        data_model.ManualData,
    )
    date_columns = []
    for model in models:
        for field_name, field_info in model.model_fields.items():
            if _is_date_like_annotation(field_info.annotation):
                date_columns.append(field_name)
    return list(dict.fromkeys(date_columns))


def format_model_date_columns_mmddyyyy(
    data_frame: pd.DataFrame,
) -> pd.DataFrame:
    date_columns = get_model_date_columns()
    for col in date_columns:
        if col not in data_frame.columns:
            continue
        parsed_dates = pd.to_datetime(data_frame[col], errors="coerce")
        data_frame[col] = parsed_dates.dt.strftime("%m/%d/%Y")
        data_frame.loc[parsed_dates.isna(), col] = None
    return data_frame


def get_filtered_datacolumn(data_frame):
    for col in all_col:
        if col not in data_frame.columns:
            data_frame[col] = None

    final_df = data_frame[all_col]
    return final_df


def apply_preprocessing_columns(
    df,
    land_id_colname,
    access_item_cols,
    sub_app_name,
):
    if df.empty:
        for col in all_col:
            if col not in df.columns:
                df[col] = None
        return df

    name_split = (
        df["Employee Last Name,First"]
        .fillna("")
        .str.strip()
        .str.split(",")
    )

    df["first_name"] = (
        name_split.str[1:].str.join(" ").str.strip(",")
    )
    df["last_name"] = name_split.str[0].str.strip(",")

    df["lan_id"] = df[land_id_colname]

    if "Employee Email" in df.columns:
        df["email_address"] = df["Employee Email"]
    elif "transfer_employee_email" in df.columns:
        df["email_address"] = df["transfer_employee_email"]
    elif "email_address" not in df.columns:
        df["email_address"] = ""

    df["emp_effective_termination_transfer_date"] = df[
        "Effective Date"
    ]

    if "active_inactive_transfer_report_date" not in df.columns:
        df["active_inactive_transfer_report_date"] = None

    if "Manager LANID" in df.columns:
        df["approved_by_manager"] = df["Manager LANID"]
    elif "transfer_manager_lanid" in df.columns:
        df["approved_by_manager"] = df["transfer_manager_lanid"]
    elif "approved_by_manager" not in df.columns:
        df["approved_by_manager"] = None

    if str(sub_app_name).lower() == "sales":
        col1 = df[access_item_cols[0]].fillna("").astype(str)
        col2 = df[access_item_cols[1]].fillna("").astype(str)
        df["access_item"] = (col1 + " / " + col2).str.strip(" / ")
    else:
        df["access_item"] = df[access_item_cols[0]]
    df["subapplication"] = sub_app_name
    df["control"] = "Transfer"

    return df
