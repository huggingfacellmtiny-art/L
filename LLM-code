def get_sharepoint_data(df, sub_app_type):
    """
    Filter the SharePoint Campaign report for ASC/ClaimsOps and return one
    dataframe for each requested sub-application.

    Campaign mapping:
        Application = ASC/ClaimsOps
        Orig_Permissions = ClaimsOps GroupName/sub-application
    """
    required_columns = [
        "Application",
        "Orig_Permissions",
    ]
    missing_columns = [
        col for col in required_columns if col not in df.columns
    ]
    if missing_columns:
        raise KeyError(
            "SharePoint Campaign report missing columns: "
            + ", ".join(missing_columns)
        )

    campaign_data = df.copy()
    campaign_data["_application_key"] = (
        campaign_data["Application"]
        .fillna("")
        .astype(str)
        .str.strip()
        .str.lower()
    )
    campaign_data["_permission_key"] = (
        campaign_data["Orig_Permissions"]
        .fillna("")
        .astype(str)
        .str.strip()
        .str.lower()
    )

    campaign_data = campaign_data[
        campaign_data["_application_key"] == "asc/claimsops"
    ].copy()

    sub_application_data = []
    for sub_app_name in sub_app_type:
        sub_app_key = str(sub_app_name).strip().lower()
        filtered_data = campaign_data[
            campaign_data["_permission_key"] == sub_app_key
        ].copy()
        filtered_data.drop(
            columns=[
                "_application_key",
                "_permission_key",
            ],
            inplace=True,
            errors="ignore",
        )
        sub_application_data.append(filtered_data)

    return tuple(sub_application_data)


