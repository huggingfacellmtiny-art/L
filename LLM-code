import os
import re
from datetime import datetime
from typing import Dict

import pandas as pd

from routine_engine.io_layer import IOLayer
from routine_engine.utils.logger import setup_logger


logger = setup_logger(__name__)


def run(context: Dict) -> Dict:
    """ClaimsOps Transfer Delta."""

    logger.info("Starting ClaimsOps Transfer Delta process.")
    IO_object = IOLayer()

    global claimsops_current_report_date
    global transfer_report_date

    properties = context.get("properties")
    input_files = properties.get("input_files")

    # Extract report dates from weekly filenames
    claimsops_current_report_date = get_date_from_filename(
        input_files["claimsops_current_week_report"]
    )
    transfer_report_date = get_date_from_filename(
        input_files["transfer_report"]
    )

    context["claimsops_current_report_date"] = claimsops_current_report_date
    context["transfer_report_date"] = transfer_report_date

    # ClaimsOps Current Week Report
    curr_claimsops = IO_object.read_excel(
        input_files["claimsops_current_week_report"]
    )
    context["claimsops"] = curr_claimsops[
        list(curr_claimsops.keys())[0]
    ]

    # Job Profile Changes / Transfer Report
    transfer_data = IO_object.read_excel(
        input_files["transfer_report"]
    )
    context["transfer"] = transfer_data[
        list(transfer_data.keys())[0]
    ]

    # ClaimsOps Transfer Delta
    # ClaimsOps Column B  : SAMAccountName
    # Transfer Column E   : Employee LANID
    context["delta_claimsops"] = extract_and_merge_df(
        left_df=context["claimsops"],
        right_df=context["transfer"][
            [
                "Employee LANID",
                "Manager LANID",
                "Effective Date",
                "Employee Last Name,First",
                "Manager Name",
            ]
        ],
        left_on="SAMAccountName",
        right_on="Employee LANID",
        join="left",
        filesheet="ClaimsOps",
        add_qc_status=True,
    )

    context["delta_claimsops_yes"] = context["delta_claimsops"][
        context["delta_claimsops"]["Status"] == "YES"
    ].copy()

    context["delta_claimsops_no"] = context["delta_claimsops"][
        context["delta_claimsops"]["Status"] == "NO"
    ].copy()

    if properties.get("save_delta"):
        output_path = properties.get("output_path")
        if not output_path:
            raise ValueError("output_path is required when save_delta is enabled")
        if not output_path.startswith(("s3://", "http://", "https://")):
            output_directory = os.path.dirname(output_path)
            if output_directory:
                os.makedirs(output_directory, exist_ok=True)
        IO_object.write_excel(
            destination_path=output_path,
            data={
                "ClaimsOps": context["delta_claimsops"],
                "ClaimsOps_YES": context["delta_claimsops_yes"],
                "ClaimsOps_NO": context["delta_claimsops_no"],
            },
        )

    logger.info("ClaimsOps Transfer Delta process completed successfully.")

    return context


def extract_and_merge_df(
    left_df: pd.DataFrame,
    right_df: pd.DataFrame,
    left_on: str,
    right_on: str,
    join: str,
    filesheet: str = "",
    add_qc_status: bool = False,
) -> pd.DataFrame:
    """Normalize LAN IDs and merge ClaimsOps with Transfer report."""

    left_df = left_df.copy()
    right_df = right_df.copy()

    # Keep original report columns unchanged.
    # Create temporary normalized keys only for comparison.
    left_df["_claimsops_lanid_key"] = normalize_identifier_series(
        left_df[left_on]
    )
    right_df["_transfer_lanid_key"] = normalize_identifier_series(
        right_df[right_on]
    )

    # Do not allow blank LANIDs to match each other.
    right_df = right_df[
        right_df["_transfer_lanid_key"].notna()
    ].copy()

    merge_df = pd.merge(
        left_df,
        right_df,
        left_on="_claimsops_lanid_key",
        right_on="_transfer_lanid_key",
        how=join,
        indicator=True,
        validate="m:1",
    )

    if add_qc_status:
        merge_df["Status"] = (
            merge_df["_merge"]
            .eq("both")
            .map({True: "YES", False: "NO"})
        )

    merge_df.drop(
        columns=[
            "_claimsops_lanid_key",
            "_transfer_lanid_key",
            "_merge",
        ],
        inplace=True,
    )

    return merge_df


def normalize_identifier_series(series: pd.Series) -> pd.Series:
    """Normalize LANID values before comparison."""

    return (
        series.astype("string")
        .str.strip()
        .str.upper()
        .replace(
            {
                "": pd.NA,
                "NAN": pd.NA,
                "NONE": pd.NA,
                "<NA>": pd.NA,
            }
        )
    )


def get_date_from_filename(file_path: str):
    """Extract the latest valid report date available in the filename."""

    filename = os.path.basename(file_path)

    patterns = [
        (r"(\d{4}-\d{2}-\d{2})", "%Y-%m-%d"),
        (r"(\d{2}-\d{2}-\d{4})", "%m-%d-%Y"),
        (r"(\d{2}_\d{2}_\d{4})", "%m_%d_%Y"),
        (r"(?<!\d)(\d{8})(?!\d)", "%Y%m%d"),
        (r"(?<!\d)(\d{8})(?!\d)", "%m%d%Y"),
    ]

    report_dates = []

    for pattern, date_format in patterns:
        for match in re.finditer(pattern, filename):
            try:
                report_dates.append(
                    datetime.strptime(
                        match.group(1),
                        date_format,
                    ).date()
                )
            except ValueError:
                continue

    if not report_dates:
        raise ValueError(
            f"Unable to extract report date from filename: {filename}"
        )

    # If filename contains a date range, use the latest/end date.
    return max(report_dates)







