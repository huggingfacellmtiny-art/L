        input_files["oracle_current_week_report"]
    )

    if not oracle_current_report_date:
        sheets = IO_object.read_excel(
            input_files["oracle_current_week_report"], header=None, nrows=5
        )
        oracle_current_report_date = get_report_date_from_heading(
            sheets, input_files["oracle_current_week_report"]
        )

    oracle_next_report_date = get_date_from_filename(
        input_files["oracle_next_week_report"]
    )

