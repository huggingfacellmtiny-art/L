        sheets = IO_object.read_excel(
            input_files["oracle_next_week_report"], header=None, nrows=5
        )
        oracle_next_report_date = get_report_date_from_heading(
            sheets, input_files["oracle_next_week_report"]
        )

    transfer_report_date = get_date_from_filename(
        input_files["transfer_report"]
    )

    context["oracle_current_report_date"] = oracle_current_report_date
    context["oracle_next_report_date"] = oracle_next_report_date
    context["transfer_report_date"] = transfer_report_date

    for context_key, input_key, required_columns in (
        ("oracle", "oracle_current_week_report", {"User Name"}),
        ("next_oracle", "oracle_next_week_report", {"User Name"}),
        ("transfer", "transfer_report", {"Employee LANID", "Manager LANID", "Effective Date", "Employee Last Name,First", "Manager Name"}),
    ):
        # Weekly report headers are on Excel row 6.
        sheets = IO_object.read_excel(
            input_files[input_key],
            skiprows=5 if context_key in ("oracle", "next_oracle") else 0,
        )
        context[context_key] = select_report_sheet(sheets, required_columns, input_key)

    context["delta_oracle"] = extract_and_merge_df(
        left_df=context["oracle"],
        right_df=context["transfer"][
            [
                "Employee LANID",
                "Manager LANID",
                "Effective Date",
                "Employee Last Name,First",
                "Manager Name",
            ]
        ],
        left_on="User Name",
        right_on="Employee LANID",
        join="left",
        filesheet="Oracle",
        add_qc_status=True,
        context=context,
    )

    context["delta_oracle_yes"] = context["delta_oracle"][
        context["delta_oracle"]["Status"] == "YES"
    ].copy()

    context["delta_oracle_no"] = context["delta_oracle"][
        context["delta_oracle"]["Status"] == "NO"
    ].copy()

