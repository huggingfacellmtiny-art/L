logger = logger_module.setup_logger(__name__)

all_col: list = (
    list(data_model.EmployeeInfo.model_fields.keys())
    + list(data_model.QCColumn.model_fields.keys())
    + list(data_model.ManualData.model_fields.keys())
)

cols_to_remove = [
    "apps_reviewed_by_manager",
    "manager_response",
    "manager_response_date",
    "ticket_creation_date",
    "ticket_no",
    "control_as_per_ticket",
    "qc_status",
    "send_mail",
    "comment",
    "evidence",
    "within_30_days",
    "approved_by_manager",
    "failure_reason",
    "business_justification",
    "attachments",
    "peer_review_status",
    "peer_review_by",
    "peer_review_date",
    "peer_review_comment",
    "provisioning_employee_deletion_date",
]

boolean_cols = ["send_mail", "within_30_days", "approved_by_manager"]
failure_reason_list = [
    "NEXT_WEEK_DATA_OVERLAP",
    "TICKET_PROCESSING_ISSUE",
    "SLA_EXCEEDED_30_DAYS",
    "NOT_PRESENT_IN_TAR",
]
claimops_send_mail = ["Yes", "No"]


def run(context: Dict) -> Dict:
    IO_object = IOLayer()
    final_df = {}
    result_transfer = {}
    tar_data = context["tar_data"]
    benefit_data = context["delta_claimsops_yes"][
        context["delta_claimsops_yes"]["GroupName"]
        .fillna("").astype(str).str.strip().str.lower()
        == "gg-claimsops_benefit"
    ].copy()
    if benefit_data.empty:
        logger.info("No GG-ClaimsOps_Benefit records found in delta_claimsops_yes")
        final_t_claimsops = benefit_data.copy()
    else:
        final_t_claimsops = benefit_data.apply(
            qc_transfer_claimsops, validation=tar_data, context=context,
            column_id_name="Name", axis=1,
        )
    final_t_claimsops = apply_preprocessing_columns(
        final_t_claimsops, land_id_colname="SAMAccountName",
        access_item_cols=["GroupName"], sub_app_name="ClaimsOps",
    )
    final_t_claimsops = convert_within_30_to_yes_no(final_t_claimsops)
    final_t_claimsops["id"] = [str(uuid.uuid4()) for _ in range(len(final_t_claimsops))]
    final_t_claimsops = get_filtered_datacolumn(final_t_claimsops)
    result_transfer["final_t_claimsops"] = (
        final_t_claimsops["qc_status"].value_counts()
        if "qc_status" in final_t_claimsops.columns else pd.Series(dtype=int)
    )
    final_t_claimsops = format_model_date_columns_mmddyyyy(final_t_claimsops)
    final_t_claimsops = normalize_yes_no_to_bool(final_t_claimsops, boolean_cols)
    result = pd.DataFrame.from_dict(result_transfer, orient="index")
    result.index.name = "application_name"
    result.reset_index(inplace=True)
    claimsops_current_report_date = context["claimsops_current_report_date"]
    transfer_report_date = context["transfer_report_date"]
    tar_report_date = context["tar_report_date"]
    final_df["qc_result"] = result
    final_df[f"tran_{transfer_report_date}"] = context["transfer"]
    final_df[f"tar_report_{tar_report_date}"] = context["tar_data"]
    final_df[f"claimsops_{claimsops_current_report_date}"] = context["delta_claimsops"].drop(
        columns=cols_to_remove, errors="ignore"
    )
    final_df["qc_claimsops"] = final_t_claimsops
    if not final_t_claimsops.empty:
        write_to_db(final_t_claimsops)
    else:
        logger.info("No ClaimsOps validation rows available to write to DB")
    try:
        IO_object.write_excel(destination_path=context["properties"]["output_path"], data=final_df)
        logger.info(f"Output written to local at path: {context['properties']['output_path']}")
    except Exception as e:
        logger.error(f"Failed to write output to local path '{context['properties']['output_path']}': {str(e)}")
    return context


def qc_transfer_claimsops(row, validation: pd.DataFrame, context: dict, column_id_name: str):
    try:
        manager_response = ""
        row["approved_by_manager"] = "No"
        out_comment = ""
        curr_qc_status = "Manual QC"
        send_mail = claimops_send_mail[0]
        failure_reason_data = []
        if str(row["Status"]).lower() == "yes":
            decision_data = ""
            val_clean = validation.copy()
            val_clean = val_clean[
                val_clean["Source Name"].fillna("").astype(str).str.strip().str.lower()
                == "active directory"
            ].copy()
            for col in ["Employee", "Account Name", "Access_Item"]:
                val_clean[col] = val_clean[col].fillna("").astype(str).str.strip().str.lower()
            val_clean = val_clean.set_index(["Employee", "Account Name", "Access_Item"])
            emp_val = str(row["Name"]).strip().lower()
            account_val = str(row["SAMAccountName"]).strip().lower()
            prf_val = str(row["GroupName"]).strip().lower()
            lookup_key = (emp_val, account_val, prf_val)
            if lookup_key not in val_clean.index:
                row["provisioning_employee_deletion_date"] = ""
                out_comment = (
                    f"Name {row['Name']}, SAMAccountName {row['SAMAccountName']}, "
                    f"GroupName {row['GroupName']} not present in "
                    f"TAR report {context['tar_report_date']} under Source Name Active Directory"
                )
                failure_reason_data.append(failure_reason_list[3])
            else:
                decision_data = val_clean.loc[lookup_key, "Decision"]
                if isinstance(decision_data, pd.Series):
                    decision_data = decision_data.iloc[0]
                decision_data = "" if pd.isna(decision_data) else str(decision_data).strip()
                manager_response = decision_data.split(".")[-1].strip()
                decision = manager_response.lower()
                if decision in {"approve", "approved"}:
                    row["approved_by_manager"] = "Yes"
                    curr_qc_status = "Passed"
                    send_mail = claimops_send_mail[1]
                    row["evidence"] = context.get("tar_report_filepath", "")
                elif decision in {"revoke", "revoked"}:
                    match_cols_next = ["SAMAccountName", "GroupName"]
                    next_claimsops_df = context.get("next_claimsops", context.get("claimops_next"))
                    if next_claimsops_df is None:
                        curr_qc_status = "Manual QC"
                        send_mail = claimops_send_mail[0]
                        row["provisioning_employee_deletion_date"] = ""
                        failure_reason_data.append(failure_reason_list[0])
                        out_comment += "TAR Decision is Revoke, but next week ClaimsOps report is not available in context"
                    else:
                        next_claimsops_df = next_claimsops_df.copy()
                        for col in match_cols_next:
                            next_claimsops_df[col] = next_claimsops_df[col].fillna("").astype(str).str.strip().str.lower()
                        current_key = (
                            str(row["SAMAccountName"]).strip().lower(),
                            str(row["GroupName"]).strip().lower(),
                        )
                        next_keys = set(zip(next_claimsops_df["SAMAccountName"], next_claimsops_df["GroupName"]))
                        if any(pd.isna(row[col]) or not str(row[col]).strip() for col in match_cols_next):
                            raise ValueError("Missing account or group for revoke validation")
                        row_matches_next_week = current_key in next_keys
                        if row_matches_next_week:
                            curr_qc_status = "Manual QC"
                            send_mail = claimops_send_mail[0]
                            row["provisioning_employee_deletion_date"] = ""
                            failure_reason_data.append(failure_reason_list[0])
                            out_comment += "Current week SAMAccountName, GroupName present in next week report"
                        else:
                            curr_qc_status = "Passed"
                            send_mail = claimops_send_mail[1]
                            row["evidence"] = context.get("tar_report_filepath", "")
                else:
                    row["provisioning_employee_deletion_date"] = ""
                    if not decision_data:
                        decision_data = "blank"
                    out_comment += f"decision data should be approve or revoke but got {decision_data}"
    except Exception as e:
        logger.exception("ClaimsOps transfer validation failed")
        curr_qc_status = "Manual QC"
        send_mail = claimops_send_mail[0]
        row["provisioning_employee_deletion_date"] = ""
        out_comment = f"Unable to validate transfer: {e}"
        failure_reason_data.append(failure_reason_list[1])
    row["qc_status"] = curr_qc_status
    row["comment"] = out_comment
    row["send_mail"] = send_mail
    row["manager_response"] = manager_response
    row["control_as_per_ticket"] = "Transfer"
    row["failure_reason"] = ", ".join(sorted(set(failure_reason_data)))
    return row


def get_filtered_datacolumn(data_frame):
    for col in all_col:
        if col not in data_frame.columns:
            data_frame[col] = None
    return data_frame[all_col]


def apply_preprocessing_columns(df, land_id_colname, access_item_cols, sub_app_name):
    if df.empty:
        for col in all_col:
            if col not in df.columns:
                df[col] = None
        return df
    name_split = df["Employee Last Name,First"].fillna("").str.strip().str.split(",")
    df["first_name"] = name_split.str[1:].str.join(" ").str.strip(",")
    df["last_name"] = name_split.str[0].str.strip(",")
    df["lan_id"] = df[land_id_colname]
    if "email_address" not in df.columns:
        df["email_address"] = ""
    df["emp_effective_termination_transfer_date"] = df["Effective Date"]
    if "approved_by_manager" not in df.columns:
        df["approved_by_manager"] = None
    df["access_item"] = df[access_item_cols[0]]
    df["subapplication"] = sub_app_name
    df["control"] = "Transfer"
    return df


def write_to_db(data):
    """
    Write data to db

    Params:
        data: dict :: data to write to db
    """
    io_layer = IOLayer()
    try:
        records = []
        for _, row in data.iterrows():
            employee_access_review = EmployeeAccessReview(
                lan_id=row.get("lan_id"),
                first_name=row.get("first_name", ""),
                last_name=row.get("last_name") if row.get("last_name") else "",
                email_address=row.get("email_address"),
                emp_effective_termination_transfer_date=_parse_date(
                    row.get("emp_effective_termination_transfer_date", None)
                ),
                title=row.get("title"),
                subapplication=row.get("subapplication"),
                control=row.get("control"),
                active_inactive_transfer_report_date=_parse_date(
                    row.get("active_inactive_transfer_report_date", None)
                ),
                active_user_report_date=_parse_date(
                    row.get("active_user_report_date", None)
                ),
                provisioning_employee_deletion_date=_parse_date(
                    row.get("provisioning_employee_deletion_date", None)
                ),
                apps_reviewed_by_manager=row.get("apps_reviewed_by_manager", ""),
                manager_response=row.get("manager_response", ""),
                manager_response_date=_parse_date(
                    row.get("manager_response_date", None)
                ),
                ticket_no=row.get("ticket_no", ""),
                ticket_creation_date=_parse_date(
                    row.get("ticket_creation_date")
                    if row.get("ticket_creation_date")
                    else None
                ),
                control_as_per_ticket=row.get("control_as_per_ticket", ""),
                qc_status=str(row.get("qc_status", ""))
                if str(row.get("qc_status", "")) in ["Passed", "Manual QC"]
                else QC_Status.MANUAL_QC,
                send_mail=str(row.get("send_mail"))
                if str(row.get("send_mail")) != "nan"
                else claimops_send_mail[1],
                comment=row.get("comment", ""),
                evidence=row.get("evidence", ""),
                within_30_days=row.get("within_30_days")
                if str(row["within_30_days"]) != "nan"
                and isinstance(row["within_30_days"], bool)
                else False,
                approved_by_manager=row.get("approved_by_manager")
                if str(row.get("approved_by_manager")) != "nan"
                else False,
                failure_reason=row.get("failure_reason", ""),
                business_justification=row.get("business_justification", ""),
                remarks=row.get("remarks", ""),
                attachments=row.get("attachments", ""),
                peer_review_comment=row.get("peer_review_comment", ""),
                peer_review_status=row.get("peer_review_status", ""),
                peer_review_by=row.get("peer_review_by", ""),
                peer_review_date=_parse_date(row.get("peer_review_date", None)),
                access_item=str(row.get("access_item", "Unknown"))
                if str(row.get("access_item")) not in ["nan", ""]
                else "Unknown",
            )
            records.append(employee_access_review)

        if records:
            io_layer.write_to_database(records)
            logger.info(f"Successfully wrote {len(records)} rows to the database")
        else:
            logger.info("No records to write to the database")
    except Exception as e:
        logger.error(f"Failed to write to the database: {e}")
        raise


def get_first_last_word(name_str):
    cleaned = str(name_str).strip().lower()
    words = [w for w in cleaned.split() if w]  # Split by whitespace

    if not words:
        return ""
    if len(words) == 1:
        return words[0]  # If only one word, take it directly

    first = words[0]
    last = words[-1]

    # If a word is 2 characters or fewer, your logic implies keeping it,
    # but let's make sure we return them separated by a space for matching.
    return f"{first} {last}"


def _parse_date(value: str):
    """Try to parse a date string into a date object using known formats.
    Returns a date object on success, or the original stripped string on failure.
    Returns None for null/NaN/empty input.
    """
    if value is None or (isinstance(value, float) and pd.isna(value)):
        return None

    value = str(value).strip()
    if not value:
        return None

    for fmt in (
        "%Y-%m-%dT%H:%M:%S.%fZ",
        "%Y-%m-%dT%H:%M:%SZ",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d",
        "%m/%d/%Y %I:%M:%S %p",
        "%m/%d/%Y %H:%M:%S",
        "%m/%d/%Y",
        "%d/%m/%Y",
        "%Y/%m/%d",
    ):
        try:
            return datetime.strptime(value.strip(), fmt).date()
        except ValueError:
            continue

    return value.strip()


def convert_within_30_to_yes_no(df):
    if "within_30_days" not in df.columns:
        df["within_30_days"] = None

    s = pd.to_numeric(df["within_30_days"], errors="coerce")
    df["within_30_days"] = (
        s.where(
            s.isna(),
            s.map(lambda x: "YES" if x < 30 else "NO"),
        )
    )
    return df


def _is_date_like_annotation(annotation: Any) -> bool:
    if annotation is date:
        return True
    origin = get_origin(annotation)
    if origin is Union:
        args = [arg for arg in get_args(annotation) if arg is not type(None)]
        return len(args) == 1 and args[0] is date
    return False


def get_model_date_columns() -> list:
    models = (data_model.EmployeeInfo, data_model.QCColumn, data_model.ManualData)
    date_columns = []
    for model in models:
        for field_name, field_info in model.model_fields.items():
            if _is_date_like_annotation(field_info.annotation):
                date_columns.append(field_name)
    return list(dict.fromkeys(date_columns))


def format_model_date_columns_mmddyyyy(data_frame: pd.DataFrame) -> pd.DataFrame:
    date_columns = get_model_date_columns()
    for col in date_columns:
        if col not in data_frame.columns:
            continue
        parsed_dates = pd.to_datetime(data_frame[col], errors="coerce")
        data_frame[col] = parsed_dates.dt.strftime("%m/%d/%Y")
        data_frame.loc[parsed_dates.isna(), col] = None
    return data_frame
